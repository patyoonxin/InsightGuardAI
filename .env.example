# ── WorkBuddy MCP ─────────────────────────────────────────────────────────────
# URL of the WorkBuddy MCP local server (SSE endpoint)
WORKBUDDY_MCP_URL=http://localhost:3000/sse

# ── OpenAI (Fallback) ─────────────────────────────────────────────────────────
# Leave blank if you don't want to use OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1 + OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.openai.com/v1
